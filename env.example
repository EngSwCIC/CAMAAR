# Copie este arquivo para .env e preencha com suas credenciais reais.
# O arquivo .env NUNCA deve ser commitado no git.

# Conta Gmail usada para envio de emails do sistema
GMAIL_USER=seu_email@gmail.com

# Senha de App do Gmail (não é a senha da sua conta Google!)
# Gere em: https://myaccount.google.com/apppasswords
GMAIL_PASSWORD=xxxx xxxx xxxx xxxx