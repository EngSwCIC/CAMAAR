                      class: "block px-4 py-2 rounded #{current_page?(user_avaliacoes_path) ? 'text-purple-700 bg-purple-100 hover:bg-purple-200' : 'text-gray-700 hover:bg-gray-100'}" %>
        </li>
      <% end %>
