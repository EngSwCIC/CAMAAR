<div class="app-shell">
  <div class="sidebar">
    <%= link_to "Avaliações", forms_path, class: "sidebar__item sidebar__item--active" %>
  </div>

  <div class="workspace">
    <div class="topbar">
      <button class="btn-menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </button>
      <h1 class="topbar__title">Avaliação - <%= @form["title"] %> - <%= @form["semester"] %></h1>
      <div class="search-pill"></div>
      <div class="avatar">U</div>
      <%= button_to "Logout", logout_path, method: :delete, class: "btn btn--ghost" %>
    </div>

    <div class="workspace__body">
      <div class="modal-page">
        <%= form_with url: create_response_form_path(@form["id"]), method: :post, class: "modal-card" do %>
          <% @form["questions"].each_with_index do |question, index| %>
            <div class="form-question">
              <h3 class="form-question__title"><%= question["title"] %></h3>
              <% if question["type"] == "radio" %>
                <div class="radio-list">
                  <% question["options"].each do |option| %>
                    <label>
                      <%= radio_button_tag "response[answers][#{question["id"]}]", option, false %>
                      <%= option %>
                    </label>
                  <% end %>
                </div>
              <% elsif question["type"] == "text" %>
                <%= text_area_tag "response[answers][#{question["id"]}]", nil, rows: 3, placeholder: "Sua resposta aqui..." %>
              <% end %>
            </div>
          <% end %>

          <div class="form-question">
            <h3 class="form-question__title">Comentários Adicionais</h3>
            <%= text_area_tag "response[comment]", nil, rows: 3, placeholder: "Seu comentário aqui..." %>
          </div>

          <%= submit_tag "Enviar Avaliação", class: "btn btn--primary" %>
        <% end %>
      </div>
    </div>
  </div>
</div>