<section class="main-area">
  <div class="button-container">
    <!-- botão visual que ativa o input de arquivo -->
    <button class="btn" type="button" onclick="document.getElementById('upload-input').click()">Importar dados</button>

    <!-- Formulário oculto mas que realiza o upload do arquivo -->
    <%= form_with url: admin_importar_dados_path, method: :post, local: true, multipart: true, html: { id: "upload-form", style: "display: none;" } do |form| %>
      <%= form.file_field :file, id: "upload-input", accept: ".json", onchange: "document.getElementById('upload-form').submit()" %>
    <% end %>

    <!-- Editar Templates -->
    <% if @can_edit_templates %>
      <%= link_to "Editar Templates", admin_templates_path, class: "btn" %>
    <% else %>
      <%= button_to "Editar Templates", "#", method: :get, class: "btn-locked", disabled: true %>
    <% end %>

    <!-- Enviar Formulários -->
    <% if @can_send_formularios %>
      <%= link_to "Enviar Formulários", new_admin_formulario_path, class: "btn" %>
    <% else %>
      <%= button_to "Enviar Formulários", "#", method: :get, class: "btn-locked", disabled: true %>
    <% end %>

    <!-- Resultados -->
    <% if @can_view_resultados %>
      <%= link_to "Resultados", admin_resultados_path, class: "btn" %>
    <% else %>
      <%= button_to "Resultados", "#", method: :get, class: "btn-locked", disabled: true %>
    <% end %>
  </div>
</section>