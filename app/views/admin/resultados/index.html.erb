<section class="main-area">

  <div class="flash-container">
    <% if flash[:error] %>
      <div class="flash flash-error">
        <%= flash[:error] %>
      </div>
    <% end %>

    <% if flash[:success] %>
      <div class="flash flash-success">
        <%= flash[:success] %>
      </div>
    <% end %>

    <% if flash[:warning] %>
      <div class="flash flash-warning">
        <%= flash[:warning] %>
      </div>
    <% end %>
  </div>

  <% if flash[:download_form_id] %>
    <iframe
        src="<%= admin_download_resultado_path(flash[:download_form_id]) %>"
        style="display:none;"
    ></iframe>
  <% end %>

  <% if @forms.any? %>
    <div class="formularios-list">
      <% @forms.each do |formulario| %>
        <% turma = formulario.turma %>
        <% materia = turma&.materia %>
        <div class="formulario-card<%= ' nao-respondido' unless formulario.respostas.any? %>">
          <strong><%= formulario.nome %></strong><br>
          <span><%= materia&.nome || '-' %></span><br>
          <span><%= turma&.semestre || '-' %></span><br>
          <span>Turma: <%= turma&.numero_turma || '-' %></span><br>
          <span><%= turma&.professor || '-' %></span><br>
          <% if formulario.respostas.any? %>
            <%= link_to admin_preparar_download_path(formulario),
                        class: "download-btn",
                        title: "Download CSV" do %>
                Download
          <% end %>
          <% else %>
            <%= link_to admin_preparar_download_path(formulario),
                        class: "download-btn disabled",
                        title: "Sem respostas" do %>
            Download
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>Nenhum formulário encontrado.</p>
  <% end %>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const alertBox = document.querySelector(".flash-error");
        if (alertBox) {
            setTimeout(() => {
                alertBox.style.opacity = "0";
                setTimeout(() => alertBox.remove(), 500);
            }, 4000);
        }
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const alertBox = document.querySelector(".flash-warning");
        if (alertBox) {
            setTimeout(() => {
                alertBox.style.opacity = "0";
                setTimeout(() => alertBox.remove(), 500);
            }, 2000);
        }
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const alertBox = document.querySelector(".flash-success");
        if (alertBox) {
            setTimeout(() => {
                alertBox.style.opacity = "0";
                setTimeout(() => alertBox.remove(), 500);
            }, 2000);
        }
    });
</script>