<div class="admin-panel">
  <h1>Relatórios Gerenciais</h1>

  <% if @formularios.any? %>
    <table class="tabela-formularios">
      <thead>
        <tr>
          <th>Pesquisa</th>
          <th>Turma</th>
          <th>Status</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @formularios.each do |formulario| %>
          <tr>
            <td><%= formulario.template.nome %></td>
            <td><%= formulario.turma.codigo %></td>
            <td><%= formulario.status.capitalize %></td>
            <td>
              <% if formulario.status == 'fechado' %>
                <%= link_to "Exportar CSV", exportar_csv_admin_resultado_path(formulario), class: "btn-exportar" %>
              <% else %>
                <span style="color: #888; font-size: 0.9em;">Relatórios só podem ser gerados para avaliações encerradas.</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>Não existem formulários disponíveis para gerar relatórios no momento</p>
  <% end %>
</div>