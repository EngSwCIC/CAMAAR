<!-- app/views/admin/turmas.html.erb -->
<% content_for :page_title, "Gerenciamento de Turmas" %>

<div class="space-y-6">
  
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <%= link_to admin_dashboard_path, class: "p-2 bg-white hover:bg-gray-100 border border-gray-200 text-gray-700 rounded-xl shadow-sm transition" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
      <% end %>
      <div>
        <span class="text-[10px] uppercase font-mono text-gray-400">Colegiado / Acadêmico</span>
        <h2 class="text-xl font-bold text-gray-900 tracking-tight">Turmas Sincronizadas</h2>
      </div>
    </div>

    <% if @aviso_mensagem.present? %>
      <button class="px-4 py-2 bg-gray-200 text-gray-400 text-xs font-bold rounded-xl cursor-not-allowed" disabled>Gerar Relatório de Desempenho</button>
    <% else %>
      <%= link_to "Gerar Relatório de Desempenho", admin_desempenho_semestral_path, class: "px-4 py-2 bg-[#702562] hover:bg-[#832d73] text-white text-xs font-bold rounded-xl shadow transition" %>
    <% end %>
  </div>

  <% if flash[:alert] %>
    <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-xl text-xs mb-4 flex items-center gap-2">
      <svg class="h-4 w-4 shrink-0 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span><%= flash[:alert] %></span>
    </div>
  <% end %>

  <% if @aviso_mensagem.present? %>
    <div class="bg-yellow-50 border border-yellow-250 text-yellow-800 p-8 rounded-3xl text-center space-y-2">
      <svg class="h-8 w-8 text-yellow-600 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <p class="text-sm font-bold"><%= @aviso_mensagem %></p>
    </div>
  <% end %>

  <!-- Turmas List -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @turmas.each do |turma| %>
      <div class="bg-white rounded-3xl p-5 border border-gray-100 shadow-sm flex flex-col justify-between hover:border-purple-250 transition text-gray-700">
        <div class="space-y-3">
          <div class="flex items-start justify-between">
            <div>
              <span class="text-[9px] font-mono bg-purple-50 text-[#702562] font-bold px-2.5 py-1 rounded-full"><%= turma.codigo %></span>
              <h3 class="font-bold text-gray-950 text-base mt-2 leading-tight"><%= turma.disciplina.nome %></h3>
              <p class="text-xs text-gray-500 mt-1">Turma <%= turma.nome %> • Semestre <%= turma.semestre %></p>
              <p class="text-[11px] text-gray-400 mt-1">Docente: <%= turma.docente.nome rescue "Não atribuído" %></p>
            </div>
          </div>
        </div>

        <div class="mt-4 pt-3 border-t border-gray-50 flex justify-end">
          <%= link_to "Visualizar Avaliações", admin_turma_avaliacoes_path(turma), class: "text-xs font-bold text-[#702562] hover:underline" %>
        </div>
      </div>
    <% end %>
  </div>

</div>
