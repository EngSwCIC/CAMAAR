<div class="page-heading">
  <h1>Ações de Gerenciamento</h1>
</div>

<div class="cards-grid">
  <div class="action-card">
    <%= link_to admin_sincronizar_sigaa_path, style: "text-decoration: none; color: inherit; width: 100%; height: 100%; display: grid; place-items: center;" do %>
      <div>
        <div style="font-size: 18px; font-weight: 700;">Importar / Atualizar</div>
        <div style="font-size: 12px; color: var(--muted);">Dados do SIGAA</div>
      </div>
    <% end %>
  </div>

  <div class="action-card">
    <%= link_to admin_templates_path, style: "text-decoration: none; color: inherit; width: 100%; height: 100%; display: grid; place-items: center;" do %>
      <div>
        <div style="font-size: 18px; font-weight: 700;">Editar Templates</div>
        <div style="font-size: 12px; color: var(--muted);">Gerenciar templates</div>
      </div>
    <% end %>
  </div>
</div>