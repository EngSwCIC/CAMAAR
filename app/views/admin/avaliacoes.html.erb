<% if @avaliacoes.present? %>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, 278px); gap: 24px; justify-content: flex-start; width: 100%;">

    <% @avaliacoes.each do |formulario| %>
      <% turma = formulario.turma %>
      <% disciplina = turma.disciplina %>
      <% professor = turma.docentes.first %>

      <div style="width: 278px; background: #FFFFFF; border-radius: 8px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; min-height: 130px; box-sizing: border-box;">
        <div>
          <p style="font-family: 'Roboto', sans-serif; font-size: 18px; font-weight: 500; margin: 0; color: #000000; line-height: 1.2;">
            <%= disciplina.nome %>
          </p>
          <p style="font-family: 'Roboto', sans-serif; font-size: 14px; font-weight: 400; margin: 4px 0 0 0; color: #000000;">
            <%= turma.semestre %><%= " — #{turma.horario}" if turma.horario.present? %>
          </p>
        </div>

        <div style="margin-top: 20px; padding-top: 12px; border-top: 1px solid #D9D9D9;">
          <p style="font-family: 'Roboto', sans-serif; font-size: 16px; font-weight: 500; margin: 0; color: #000000;">
            <%= professor&.nome || "Professor(a) não alocado(a)" %>
          </p>
        </div>
      </div>
    <% end %>

  </div>
<% else %>
  <div style="background: #FFFFFF; border-radius: 8px; width: 100%; height: 300px; display: flex; align-items: center; justify-content: center;">
    <p style="font-family: 'Roboto', sans-serif; font-size: 16px; color: #8E8E8E;">Nenhuma avaliação disponível no momento.</p>
  </div>
<% end %>
