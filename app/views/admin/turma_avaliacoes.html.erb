<!-- app/views/admin/turma_avaliacoes.html.erb -->
<% content_for :page_title, "Avaliações da Turma" %>

<div class="space-y-6">
  
  <div class="flex items-center gap-3">
    <%= link_to admin_turmas_path, class: "p-2 bg-white hover:bg-gray-100 border border-gray-200 text-gray-700 rounded-xl shadow-sm transition" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
    <% end %>
    <div>
      <span class="text-[10px] uppercase font-mono text-gray-400">Turmas / Avaliações</span>
      <h2 class="text-xl font-bold text-gray-900 tracking-tight">Avaliações da Turma <%= @turma.codigo_turma %></h2>
    </div>
  </div>

  <div class="bg-white rounded-3xl p-6 border border-gray-100 shadow-sm space-y-4">
    <h3 class="font-bold text-gray-950 text-base"><%= @turma.disciplina.nome %></h3>
    <p class="text-xs text-gray-500">Docente: <%= @turma.docente.nome rescue "Não atribuído" %> • Semestre Letivo: <%= @turma.semestre %></p>
  </div>

  <!-- Formularios da Turma -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <% if @formularios.blank? %>
      <div class="col-span-2 bg-white p-12 text-center rounded-3xl border border-gray-150">
        <p class="text-sm font-semibold text-gray-400">Nenhum formulário ativo direcionado a esta turma.</p>
      </div>
    <% else %>
      <% @formularios.each do |form| %>
        <div class="bg-white rounded-3xl p-5 border border-gray-100 shadow-sm space-y-4 text-gray-700">
          <div>
            <span class="text-[9px] font-mono bg-purple-50 text-[#702562] font-bold px-2.5 py-1 rounded-full"><%= form.publico_alvo %></span>
            <h4 class="font-bold text-gray-950 mt-2"><%= form.template.titulo %></h4>
            <p class="text-xs text-gray-500 mt-1">Status: <%= form.status %> • Período: <%= form.data_inicio.strftime('%d/%m/%Y') rescue 'N/A' %> a <%= form.data_limite.strftime('%d/%m/%Y') rescue 'N/A' %></p>
          </div>
          
          <div class="pt-3 border-t border-gray-50 flex justify-end">
            <%= link_to "Ver Resultados", resultado_path(form), class: "text-xs font-bold text-[#702562] hover:underline" %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

</div>
