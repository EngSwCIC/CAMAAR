<!DOCTYPE html>
<html>
  <head>
    <title>Camaar</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body>
    <% if flash[:notice].present? %>
      <div style="padding: 15px; margin-bottom: 20px; background-color: #d4edda; color: #155724;"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert].present? %>
      <div style="padding: 15px; margin-bottom: 20px; background-color: #f8d7da; color: #721c24;"><%= flash[:alert] %></div>
    <% end %>

    <%= yield %>
  </body>
</html>