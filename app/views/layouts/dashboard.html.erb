<!DOCTYPE html>
<html>
  <head>
    <title>CAMAAR</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "home", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      .btn {
        display: inline-block;
        padding: 8px 16px;
        background-color: #007bff;
        color: white;
        text-decoration: none;
        border-radius: 4px;
      }
      .card {
        border: 1px solid #ddd;
        padding: 16px;
        margin-bottom: 16px;
        border-radius: 8px;
        background: white;
      }
      .status {
        font-weight: bold;
        padding: 4px 8px;
        border-radius: 4px;
        background: #eee;
      }
      .menu-item {
        display: block;
        text-decoration: none;
        color: inherit;
        padding: 12px;
        text-align: center;
        border-bottom: 1px solid #ddd;
      }
      .menu-item:hover {
        background: #f5f5f5;
      }
      .alert {
        padding: 12px;
        margin-bottom: 16px;
        border-radius: 4px;
      }
      .alert-success { background: #d4edda; color: #155724; }
      .alert-danger { background: #f8d7da; color: #721c24; }
    </style>
  </head>

  <body>
    <div class="header">
      <div class="header-left">
        <div class="menu-icon">☰</div>
        <span class="title">CAMAAR</span>
      </div>

      <div class="header-right">
          <div class="user-avatar-wrapper">
            <span style="margin-right: 10px;"><%= current_user&.email %></span>
            <%= button_to "Logout", logout_path, method: :delete, class: "logout-btn" %>
          </div>
      </div>
    </div>

    <aside class="sidebar">
      <%= link_to "Avaliações", formularios_path, class: "menu-item" %>
      <% if current_user&.admin? %>
        <%= link_to "Gerenciamento", admin_imports_path, class: "menu-item" %>
      <% end %>
    </aside>

    <main class="main">
      <% if flash[:notice] %>
        <div class="alert alert-success"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="alert alert-danger"><%= flash[:alert] %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
