<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "Login - Camaar" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <!-- Fontes e ícones (opcional, se necessário) -->
  <link href="https://fonts.googleapis.com/css?family=Roboto&display=swap" rel="stylesheet" />
</head>
<body class="font-roboto bg-[#dbdbdb] min-h-screen flex items-center justify-center">
<%= yield %>
</body>
</html>