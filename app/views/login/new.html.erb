<!DOCTYPE html>
<html>
<head>
  <%= csrf_meta_tags %>
  <link href="https://fonts.googleapis.com/css?family=Roboto&display=swap" rel="stylesheet" />
  <title>Login</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style type="text/tailwindcss">
      @layer components {
          .input {
              @apply w-full px-3 py-2 mb-4 border border-gray-300 rounded-md text-sm;
          }
          .entrar {
              @apply w-full py-3 px-4 bg-green-500 text-white font-medium rounded-md hover:bg-green-600 transition-colors;
          }
      }
  </style>
</head>
<body class="bg-gray-200 flex justify-center items-center min-h-screen font-roboto">
<div class="w-full max-w-[898px] bg-white rounded-lg shadow-lg overflow-hidden">
  <div class="flex h-[525px] bg-[#6C2365]">
    <!-- Lado esquerdo: login -->
    <div class="w-[398px] bg-white p-[60px_40px] flex flex-col justify-center">
      <span class="text-2xl font-normal text-center mb-6">LOGIN</span>

      <% if flash.now[:alert] %>
        <div class="mt-2 mb-2 text-sm text-[#721c24] font-roboto">
          <%= flash.now[:alert] %>
        </div>
      <% end %>

      <%= form_with url: login_path, method: :post, local: true, class: "w-full" do |f| %>
        <div class="mb-1">
          <%= f.label :email, "Email", class: "text-[#333f51] font-normal" %>
          <%= f.text_field :email, placeholder: "aluno@aluno.unb.br", class: "input", required: true %>
        </div>

        <div class="mb-1">
          <%= f.label :password, "Senha", class: "text-[#333f51] font-normal" %>
          <%= f.password_field :password, placeholder: "Password", class: "input", required: true %>
        </div>

        <div class="mt-4">
          <%= f.submit "Entrar", class: "entrar" %>
        </div>
      <% end %>

      <div class="mt-4 text-center">
        <%= link_to "Esqueceu sua senha?", new_password_path, class: "text-gray-600 text-sm hover:underline" %>
      </div>
    </div>

    <!-- Lado direito: boas-vindas -->
    <div class="flex-1 flex items-center justify-center text-center">
      <span class="text-white font-medium text-[56px] leading-tight">
        Bem vindo<br>
        ao<br>
        Camaar
      </span>
    </div>
  </div>
</div>
</body>
</html>