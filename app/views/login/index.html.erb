<!DOCTYPE html>
<html>
<head>
  <link href="https://fonts.googleapis.com/css?family=Roboto&display=swap" rel="stylesheet" />
  <link href="app/assets/stylesheets/login.css" rel="stylesheet" />
  <title>Login</title>
</head>
<body>
<div class="Fundo-branco">
  <div class="Fundo-roxo">
    <!-- Lado esquerdo: login -->
    <div class="Caixa-login">
      <span class="login">LOGIN</span>

      <%= form_with url: login_path, method: :post, local: true do |f| %>
        <div class="email">
          <%= f.label :email, "Email", class: "email" %><br>
          <%= f.email_field :email, placeholder: "aluno@aluno.unb.br", class: "input", required: true %>
        </div>

        <div class="senha">
          <%= f.label :password, "Senha", class: "senha" %><br>
          <%= f.password_field :password, placeholder: "Password", class: "input", required: true %>
        </div>

        <div>
          <%= f.submit "Entrar", class: "entrar" %>
        </div>
      <% end %>

      <div class="esqueci-senha">
        <%= link_to "Esqueceu sua senha?", new_password_path %>
      </div>
    </div>

    <div class="Caixa-bv">
        <span class="bem-vindo">Bem vindo<br>
          ao<br>
          Camaar
        </span>
    </div>
  </div>
</div>
</body>
</html>