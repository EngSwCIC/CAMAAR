<h1><%= @formulario.nome_formulario %></h1>

<%= form_with url: formulario_respostas_path(@formulario), method: :post do |f| %>
  <% @pergunta_formularios.each_with_index do |pf, i| %>
    <div>
      <label>
        <%= "#{i + 1}. #{pf.enunciado}" %>
        *
      </label>
      <%= text_area_tag "respostas[#{pf.id}]", params.dig(:respostas, pf.id.to_s), rows: 3 %>
    </div>
  <% end %>

  <p><small>* Questões obrigatórias</small></p>
  <%= f.submit "Enviar respostas" %>
<% end %>

<%= link_to "Voltar", avaliacoes_path %>
