<!-- app/views/formularios/new.html.erb -->
<% content_for :page_title, "Distribuir Formulários de Pesquisa" %>

<div class="space-y-6">
  
  <!-- Header de Voltar -->
  <div class="flex items-center gap-3">
    <%= link_to admin_dashboard_path, class: "p-2 bg-white hover:bg-gray-100 border border-gray-200 text-gray-700 rounded-xl shadow-sm transition" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
    <% end %>
    <div>
      <span class="text-[10px] uppercase font-mono text-gray-400">Administração / Distribuidor</span>
      <h2 class="text-xl font-bold text-gray-900 tracking-tight">Ativação de Pesquisas</h2>
    </div>
  </div>

  <% if flash[:alert] %>
    <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-xl text-xs mb-4 flex items-center gap-2">
      <svg class="h-4 w-4 shrink-0 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span><%= flash[:alert] %></span>
    </div>
  <% end %>

  <div class="bg-white rounded-3xl p-6 md:p-8 border border-gray-100 shadow-md">
    <%= form_with url: formularios_path, local: true, method: :post, class: "space-y-6" do |f| %>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        
        <!-- Seletor de Template -->
        <div class="space-y-1">
          <label for="template_id" class="text-xs font-bold text-gray-500 uppercase tracking-wider">Selecione o Template do Inquérito</label>
          <%= f.select :template_id, @templates.map { |t| [t.titulo, t.id] }, {}, id: "template_id", class: "w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs focus:outline-none focus:border-[#702562] text-gray-700 font-semibold" %>
        </div>

        <!-- Seletor de Turma (Single creation) -->
        <div class="space-y-1">
          <label for="turma_id" class="text-xs font-bold text-gray-500 uppercase tracking-wider">Turma</label>
          <%= f.select :turma_id, @turmas.map { |t| ["#{t.codigo} - Turma #{t.nome}", t.id] }, { include_blank: "Selecione uma turma (ou use a tabela abaixo)" }, id: "turma_id", class: "w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs focus:outline-none focus:border-[#702562] text-gray-700" %>
        </div>

        <!-- Público-alvo -->
        <div class="space-y-1">
          <label for="publico_alvo" class="text-xs font-bold text-gray-500 uppercase tracking-wider">Público-alvo</label>
          <%= f.select :publico_alvo, [['Discentes', 'discente'], ['Docentes', 'docente']], { include_blank: "Selecione..." }, id: "publico_alvo", class: "w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs focus:outline-none focus:border-[#702562] text-gray-700" %>
        </div>

        <!-- Status -->
        <div class="space-y-1">
          <label for="status" class="text-xs font-bold text-gray-500 uppercase tracking-wider">Status</label>
          <%= f.select :status, [['Aberto', 'aberto'], ['Fechado', 'fechado']], {}, id: "status", class: "w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs focus:outline-none focus:border-[#702562] text-gray-700" %>
        </div>

        <!-- Data de Início -->
        <div class="space-y-1">
          <label for="data_inicio" class="text-xs font-bold text-gray-500 uppercase tracking-wider">Data de Início</label>
          <%= f.text_field :data_inicio, id: "data_inicio", placeholder: "YYYY-MM-DD", class: "w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs focus:outline-none focus:border-[#702562] text-gray-700" %>
        </div>

        <!-- Data Limite -->
        <div class="space-y-1">
          <label for="data_limite" class="text-xs font-bold text-gray-500 uppercase tracking-wider">Data Limite</label>
          <%= f.text_field :data_limite, id: "data_limite", placeholder: "YYYY-MM-DD", class: "w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs focus:outline-none focus:border-[#702562] text-gray-700" %>
        </div>

      </div>

      <!-- Tabela de Turmas a serem vinculadas (Batch creation) -->
      <div class="space-y-3 pt-4">
        <div class="flex items-center justify-between">
          <h3 class="font-bold text-xs text-gray-500 uppercase tracking-wider">Selecione as Turmas Ativas (Para envio em Lote)</h3>
          <div class="flex gap-2">
            <button type="button" onclick="toggleAllCheckboxes(true)" class="px-2.5 py-1 text-[10px] bg-gray-50 border border-gray-200 rounded-lg text-gray-600 font-semibold uppercase hover:bg-gray-100 cursor-pointer">Marcar Todas</button>
            <button type="button" onclick="toggleAllCheckboxes(false)" class="px-2.5 py-1 text-[10px] bg-gray-50 border border-gray-200 rounded-lg text-gray-600 font-semibold uppercase hover:bg-gray-100 cursor-pointer">Desmarcar Todas</button>
          </div>
        </div>

        <div class="overflow-x-auto border border-gray-100 rounded-2xl">
          <table class="w-full text-left text-xs text-gray-700">
            <thead class="bg-gray-50 text-gray-500 font-bold uppercase tracking-wider border-b border-gray-100">
              <tr>
                <th class="p-4 w-12 text-center">Selec.</th>
                <th class="p-4">Código / Turma</th>
                <th class="p-4">Disciplina</th>
                <th class="p-4">Docente Responsável</th>
                <th class="p-4 text-center">Inscritos</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white">
              <% @turmas.each do |turma| %>
                <tr class="hover:bg-purple-50/50 transition duration-150">
                  <td class="p-4 text-center">
                    <input type="checkbox" name="turma_ids[]" value="<%= turma.id %>" class="turma-checkbox h-4.5 w-4.5 rounded text-[#702562] focus:ring-[#702562] border-gray-300 cursor-pointer">
                  </td>
                  <td class="p-4 font-mono font-bold text-gray-900">
                    <%= turma.codigo %> - Turma <%= turma.nome %>
                  </td>
                  <td class="p-4 text-gray-700">
                    <%= turma.disciplina.nome rescue "N/C" %>
                  </td>
                  <td class="p-4 font-medium text-gray-600">
                    <%= turma.docente.nome rescue "Não atribuído" %>
                  </td>
                  <td class="p-4 text-center font-bold font-mono text-gray-900">
                    <%= turma.matriculas_count rescue 0 %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Submit buttons -->
      <div class="pt-4 border-t border-gray-100 flex flex-wrap justify-end gap-3">
        <%= f.submit "Criar Formulário", class: "px-6 py-2.5 bg-[#702562] hover:bg-[#832d73] text-white font-bold text-xs uppercase tracking-widest rounded-xl shadow transition cursor-pointer" %>
        <%= f.submit "Salvar e Publicar", class: "px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs uppercase tracking-widest rounded-xl shadow transition cursor-pointer" %>
        <%= f.submit "Disparar Questionários", class: "px-6 py-2.5 bg-green-600 hover:bg-green-700 text-white font-bold text-xs uppercase tracking-widest rounded-xl shadow transition cursor-pointer" %>
      </div>

    <% end %>
  </div>

</div>

<script>
  function toggleAllCheckboxes(checked) {
    const checkboxes = document.querySelectorAll('.turma-checkbox');
    checkboxes.forEach(cb => cb.checked = checked);
  }
</script>
