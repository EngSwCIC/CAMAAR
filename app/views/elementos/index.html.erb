<p style="color: green"><%= notice %></p>

<% content_for :title, "Elementos" %>

<h1>Elementos</h1>

<div id="elementos">
  <% @elementos.each do |elemento| %>
    <%= render elemento %>
    <p>
      <%= link_to "Show this elemento", elemento %>
    </p>
  <% end %>
</div>

<%= link_to "New elemento", new_elemento_path %>
