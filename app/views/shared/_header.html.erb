<!-- app/views/shared/_header.html.erb -->
<header class="sticky top-0 z-40 bg-white border-b border-gray-100 h-16 px-4 md:px-6 flex items-center justify-between shadow-sm select-none">
  
  <!-- Left Side: Hambúrguer + Título da Página -->
  <div class="flex items-center gap-3">
    <button id="btn-sidebar-toggle" onclick="toggleRailsSidebar()" class="p-1.5 hover:bg-gray-100 rounded-lg text-gray-700 transition" title="Alternar Menu">
      <!-- Icon menu simplificado -->
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
    <h1 class="text-lg md:text-xl font-medium text-gray-800 tracking-tight">
      <%= yield :page_title if content_for?(:page_title) %>
    </h1>
  </div>

  <!-- Center Search: Caixa de Pesquisa Responsiva -->
  <div class="flex-1 max-w-md mx-4 md:mx-8 hidden sm:block">
    <div class="relative">
      <span class="absolute inset-y-0 left-3 flex items-center text-gray-400 pointer-events-none">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </span>
      <input type="text" placeholder="Pesquisar..." id="rails-search-input" class="w-full pl-10 pr-4 py-2 bg-gray-50 border border-gray-200 rounded-full focus:outline-none focus:border-[#702562] focus:bg-white text-sm text-gray-700 transition shadow-inner">
    </div>
  </div>

  <!-- Right Side: Perfil / Menu Dropdown -->
  <div class="flex items-center gap-3 relative">
    <div class="hidden lg:flex flex-col items-end text-right text-xs">
      <span class="font-semibold text-gray-800"><%= current_user.nome %></span>
      <span class="text-gray-500 capitalize"><%= current_user.perfil %></span>
    </div>

    <!-- Círculo de Iniciais -->
    <button onclick="toggleUserDropdown()" class="w-10 h-10 bg-[#702562] hover:bg-[#832d73] text-white font-semibold text-lg flex items-center justify-center rounded-full transition focus:outline-none">
      <%= current_user.nome.first.upcase %>
    </button>

    <!-- Dropdown Menu -->
    <div id="user-dropdown-popover" class="hidden absolute right-0 top-12 w-64 bg-white rounded-xl shadow-xl border border-gray-100 py-2 z-50 text-sm text-gray-700">
      <div class="px-4 py-3 border-b border-gray-100">
        <p class="font-bold text-gray-950 truncate"><%= current_user.nome %></p>
        <p class="text-xs text-gray-500 truncate"><%= current_user.email %></p>
        <p class="text-[10px] text-gray-400 font-mono mt-1">Matrícula: <%= current_user.matricula %></p>
      </div>

      <div class="py-1">
        <div class="px-4 py-2 text-xs font-semibold text-gray-400 uppercase tracking-widest flex items-center gap-1">
          <span>CIC / UnB</span>
        </div>
        
        <%= link_to logout_path, method: :delete, class: "w-full text-left px-4 py-2 flex items-center gap-2 hover:bg-gray-100 text-red-600 font-medium transition-colors" do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          Sair do Sistema
        <% end %>
      </div>
    </div>
  </div>
</header>

<script>
  function toggleUserDropdown() {
    const dropdown = document.getElementById('user-dropdown-popover');
    dropdown.classList.toggle('hidden');
  }

  function toggleRailsSidebar() {
    const sidebar = document.getElementById('main-sidebar');
    const content = document.getElementById('main-content-wrapper');
    if (sidebar.classList.contains('translate-x-0')) {
      // fechar
      sidebar.classList.remove('translate-x-0', 'w-64');
      sidebar.classList.add('-translate-x-full', 'w-0');
      content.classList.remove('pl-64');
      content.classList.add('pl-0');
    } else {
      // abrir
      sidebar.classList.remove('-translate-x-full', 'w-0');
      sidebar.classList.add('translate-x-0', 'w-64');
      content.classList.remove('pl-0');
      content.classList.add('pl-64');
    }
  }
</script>
