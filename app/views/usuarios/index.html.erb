<p style="color: green"><%= notice %></p>

<% content_for :title, "Usuarios" %>

<h1>Usuarios</h1>

<div id="usuarios">
  <% @usuarios.each do |usuario| %>
    <%= render partial: "usuario", object: usuario %>
    <p>
      <%= link_to "Show this usuario", usuario_path(usuario) %>
    </p>
  <% end %>
</div>

<%= link_to "New usuario", new_usuario_path %>
