<div class="main-page">
  <div class="redefinir-container">
    <h1>NOVA SENHA</h1>

    <% if flash[:alert] %>
      <p class="auth-alert"><%= flash[:alert] %></p>
    <% end %>

    <%= form_with url: senha_nova_path, method: :post, class: "login-form" do |form| %>
      <%= form.hidden_field :token, value: @token %>
      <div class="form-group">
        <%= form.password_field :password, placeholder: "Nova senha (mín. 8 chars, letras e números)" %>
      </div>
      <div class="form-group">
        <%= form.password_field :password_confirmation, placeholder: "Confirmar nova senha" %>
      </div>
      <%= form.submit "Redefinir senha", class: "login-button" %>
    <% end %>
  </div>
</div>
