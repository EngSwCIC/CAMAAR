<div class="main-page">
  <div class="redefinir-container">
    <h1>ALTERAR SENHA</h1>

    <% if notice %>
      <p class="auth-notice"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="auth-alert"><%= alert %></p>
    <% end %>

    <%= form_with url: senha_redefinir_path, method: :post, class: "login-form" do |form| %>
      <div class="form-group">
        <%= form.password_field :password, placeholder: "Senha atual" %>
      </div>
      <div class="form-group">
        <%= form.password_field :new_password_1, placeholder: "Nova senha" %>
      </div>
      <div class="form-group">
        <%= form.password_field :new_password_2, placeholder: "Confirmar nova senha" %>
      </div>
      <%= form.submit "Alterar", class: "login-button" %>
    <% end %>
  </div>
</div>
