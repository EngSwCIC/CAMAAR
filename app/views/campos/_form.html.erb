<%= form_with(model: campo) do |form| %>
  <% if campo.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(campo.errors.count, "error") %> prohibited this campo from being saved:</h2>

      <ul>
        <% campo.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :ordem, style: "display: block" %>
