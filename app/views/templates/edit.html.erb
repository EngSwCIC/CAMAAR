<!-- app/views/templates/edit.html.erb -->
<% content_for :page_title, "Editar Template" %>

<!-- View para edição de template (Issue #112) -->
<div class="space-y-6">
  <div class="flex items-center gap-3">
    <%= link_to templates_path, class: "p-2 bg-white hover:bg-gray-100 border border-gray-200 text-gray-700 rounded-xl shadow-sm transition" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
    <% end %>
    <div>
      <span class="text-[10px] uppercase font-mono text-gray-400">Administração / Templates</span>
      <h2 class="text-xl font-bold text-gray-900 tracking-tight">Editar Template</h2>
    </div>
  </div>

  <% if flash[:alert] %>
    <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-xl text-xs mb-4">
      <span><%= flash[:alert] %></span>
    </div>
  <% end %>

  <div class="bg-white rounded-3xl p-6 md:p-8 border border-gray-100 shadow-md">
    <%= form_with model: @template, url: template_path(@template), local: true, method: :put, class: "space-y-6" do |f| %>
      <div class="space-y-4">
        <div class="space-y-1">
          <%= f.label :titulo, "Título", class: "text-xs font-bold text-gray-500 uppercase tracking-wider" %>
          <%= f.text_field :titulo, id: "template_titulo", placeholder: "Escreva o título...", class: "w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs focus:outline-none focus:border-[#702562] text-gray-700" %>
        </div>

        <div class="space-y-1">
          <%= f.label :descricao, "Descrição", class: "text-xs font-bold text-gray-500 uppercase tracking-wider" %>
          <%= f.text_area :descricao, id: "template_descricao", placeholder: "Escreva a descrição...", class: "w-full h-24 px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs focus:outline-none focus:border-[#702562] text-gray-700" %>
        </div>
      </div>

      <%= f.submit "Atualizar Template", class: "px-6 py-2.5 bg-[#702562] hover:bg-[#832d73] text-white font-bold text-xs uppercase tracking-widest rounded-xl transition cursor-pointer" %>
    <% end %>
  </div>
</div>
