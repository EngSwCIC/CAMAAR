<!-- app/views/sessions/new.html.erb - Tela de login com design moderno -->
<% content_for :page_title, "Identificação" rescue nil %>

<div class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-gray-100 p-8 md:p-10 text-gray-700 animate-fade-in">
  <!-- Logo / Cabeçalho -->
  <div class="text-center space-y-2 mb-8">
    <div class="w-16 h-16 bg-[#702562] rounded-full flex items-center justify-center mx-auto shadow-md">
      <svg class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>
    </div>
    <h2 class="text-2xl font-black text-gray-900 tracking-tight">CAMAAR</h2>
    <p class="text-xs text-gray-400 font-medium tracking-wide uppercase">CIC | UNB</p>
  </div>

  <% if flash[:notice] %>
    <div class="bg-green-50 border border-green-200 text-green-700 p-3 rounded-lg text-xs mb-4 flex items-center gap-2">
      <svg class="h-4 w-4 shrink-0 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span><%= flash[:notice] %></span>
    </div>
  <% end %>

  <% if flash[:alert] %>
    <div class="bg-red-50 border border-red-200 text-red-700 p-3 rounded-lg text-xs mb-4 flex items-center gap-2">
      <svg class="h-4 w-4 shrink-0 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span><%= flash[:alert] %></span>
    </div>
  <% end %>

  <!-- Formulário de Autenticação -->
  <%= form_with url: login_path, local: true, class: "space-y-5" do |f| %>
    <!-- Campo de E-mail ou Matrícula -->
    <div class="space-y-1">
      <label for="email" class="text-xs font-bold text-gray-500 uppercase tracking-wider">E-mail ou Matrícula</label>
      <div class="relative">
        <span class="absolute inset-y-0 left-3 flex items-center text-gray-400 pointer-events-none">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
          </svg>
        </span>
        <%= f.text_field :email, id: "email", placeholder: "usuario@unb.br ou matrícula", class: "w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:border-[#702562] focus:bg-white text-xs text-gray-700 transition" %>
      </div>
    </div>

    <!-- Campo de Senha -->
    <div class="space-y-1">
      <div class="flex justify-between items-center">
        <label for="password" class="text-xs font-bold text-gray-500 uppercase tracking-wider">Senha</label>
        <%= link_to "Esqueci minha senha", forgot_password_path, class: "text-[11px] font-bold text-[#702562] hover:underline" %>
      </div>
      <div class="relative">
        <span class="absolute inset-y-0 left-3 flex items-center text-gray-400 pointer-events-none">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </span>
        <%= f.password_field :password, id: "password", placeholder: "••••••••", class: "w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:border-[#702562] focus:bg-white text-xs text-gray-700 transition" %>
      </div>
    </div>

    <!-- Botão Enviar -->
    <%= f.submit "Entrar", class: "w-full py-3 mt-2 bg-[#702562] hover:bg-[#832d73] text-white font-bold text-xs uppercase tracking-widest rounded-xl shadow-lg hover:shadow-xl active:scale-98 transition duration-150 cursor-pointer" %>
  <% end %>

</div>
