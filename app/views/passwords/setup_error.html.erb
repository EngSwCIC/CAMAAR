<!-- app/views/passwords/setup_error.html.erb -->
<div class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-gray-100 p-8 text-center text-gray-700">
  <div class="text-red-500 mb-4 flex justify-center">
    <svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
  </div>
  
  <h3 class="font-bold text-gray-900 text-lg mb-2">Erro de Acesso</h3>
  
  <p class="text-xs text-gray-600 mb-6"><%= flash[:alert] %></p>
  
  <% if flash[:alert]&.include?("Link expirado") %>
    <div class="mb-4">
      <button type="button" class="px-4 py-2 bg-[#702562] hover:bg-[#832d73] text-white text-xs font-bold rounded-xl cursor-pointer">Solicitar novo link de ativação</button>
    </div>
  <% end %>

  <%= link_to "Voltar para o Login", login_path, class: "block text-xs font-bold text-[#702562] hover:underline" %>
</div>
