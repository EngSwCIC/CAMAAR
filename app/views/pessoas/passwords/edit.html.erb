<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Defina sua Senha - CAMAAR</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag 'login', media: 'all' %>
</head>
<body>
<div class="login-container">
  <div class="login-form">
    <h2>DEFINA SUA SENHA</h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= f.hidden_field :reset_password_token, value: params[:reset_password_token] || resource.reset_password_token %>

      <div class="form-group">
        <%= f.label :password, "Nova Senha" %><br>
        <%= f.password_field :password, class: "input", autofocus: true %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation, "Confirme a Senha" %><br>
        <%= f.password_field :password_confirmation, class: "input" %>
      </div>

      <div class="form-actions">
        <%= f.submit "Definir Senha", class: "btn" %>
      </div>

      <% if flash[:alert] %>
        <div class="alert-message"><%= flash[:alert] %></div>
      <% end %>

      <% if flash[:notice] %>
        <div class="notice-message"><%= flash[:notice] %></div>
      <% end %>
    <% end %>
  </div>

  <div class="login-banner">
    <h1>Bem vindo<br>ao<br>Camaar</h1>
  </div>
</div>
</body>
</html>
