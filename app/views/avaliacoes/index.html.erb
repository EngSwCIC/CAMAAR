<!-- app/views/avaliacoes/index.html.erb -->
<% content_for :page_title, "Pesquisas de Avaliação" %>

<div class="space-y-6">
  
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-gray-900 tracking-tight">Suas Pesquisas Ativas</h2>
      <p class="text-xs text-gray-500">Selecione uma matéria correspondente para preencher o inquérito de opinião do Colegiado.</p>
    </div>
  </div>

  <% if flash[:notice] %>
    <div class="bg-green-50 border border-green-200 text-green-700 p-4 rounded-xl text-xs mb-4 flex items-center gap-2">
      <svg class="h-4 w-4 shrink-0 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span><%= flash[:notice] %></span>
    </div>
  <% end %>

  <% if flash[:alert] %>
    <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-xl text-xs mb-4 flex items-center gap-2">
      <svg class="h-4 w-4 shrink-0 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span><%= flash[:alert] %></span>
    </div>
  <% end %>

  <!-- Cards das Avaliações disponíveis -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    
    <% if @pesquisas_pendentes.nil? || @pesquisas_pendentes.blank? %>
      <div class="col-span-1 md:col-span-3 bg-white p-12 text-center rounded-3xl border border-gray-150">
        <div class="w-12 h-12 bg-green-50 text-green-600 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <p class="text-sm font-bold text-gray-800">Você não possui formulários pendentes para responder no momento</p>
        <p class="text-xs text-gray-400 mt-1">O Colegiado do CIC agradece sua primordial participação.</p>
      </div>
    <% else %>
      <% @pesquisas_pendentes.each do |formulario| %>
        <div class="bg-white rounded-3xl p-5 md:p-6 border border-gray-100 shadow-sm flex flex-col justify-between hover:border-purple-250 transition text-gray-700">
          <div class="space-y-4">
            <div class="flex items-start justify-between">
              <div>
                <span class="text-[9px] font-mono bg-purple-50 text-[#702562] font-bold px-2.5 py-1 rounded-full">
                  <%= formulario.turma.codigo rescue "N/C" %>
                </span>
                <h3 class="font-bold text-gray-950 text-base mt-2 leading-tight">
                  <%= formulario.turma.disciplina.nome rescue "N/C" %>
                </h3>
                <p class="text-xs text-gray-500 mt-1">
                  Prof: <b><%= formulario.turma.docente.nome rescue "Não atribuído" %></b>
                </p>
              </div>
            </div>

            <!-- Descrição template -->
            <div class="p-3 bg-gray-50 rounded-xl border border-gray-200/50 text-[10px] text-gray-500">
              <span class="font-bold text-gray-700">Formulário:</span> <%= formulario.template.titulo %>
            </div>
          </div>

          <!-- Ação preenchimento -->
          <div class="mt-6 pt-4 border-t border-gray-50 flex items-center justify-between">
            <span class="text-[10px] uppercase font-bold text-[#702562] tracking-wider">Status: Pendente</span>
            <%= link_to responder_avaliacao_path(formulario), class: "px-4 py-2 bg-[#702562] hover:bg-[#832d73] text-white font-extrabold text-[10px] uppercase tracking-wider rounded-xl transition cursor-pointer" do %>
              Preencher
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>

  </div>

  <% if current_user.perfil != 'administrador' && @pesquisas_respondidas.present? && @pesquisas_respondidas.any? %>
    <div class="mt-12">
      <h2 class="text-lg font-bold text-gray-900 tracking-tight mb-4">Pesquisas Já Respondidas</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @pesquisas_respondidas.each do |formulario| %>
          <div class="bg-gray-50 rounded-3xl p-5 md:p-6 border border-gray-200 shadow-sm flex flex-col justify-between opacity-80 text-gray-500">
            <div class="space-y-4">
              <div class="flex items-start justify-between">
                <div>
                  <span class="text-[9px] font-mono bg-gray-200 text-gray-600 font-bold px-2.5 py-1 rounded-full">
                    <%= formulario.turma.codigo rescue "N/C" %>
                  </span>
                  <h3 class="font-bold text-gray-700 text-base mt-2 leading-tight">
                    <%= formulario.turma.disciplina.nome rescue "N/C" %>
                  </h3>
                  <p class="text-xs text-gray-400 mt-1">
                    Prof: <b><%= formulario.turma.docente.nome rescue "Não atribuído" %></b>
                  </p>
                </div>
                <div class="bg-green-100 text-green-600 rounded-full p-1.5">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
              </div>

              <!-- Descrição template -->
              <div class="p-3 bg-white rounded-xl border border-gray-200/50 text-[10px] text-gray-400">
                <span class="font-bold text-gray-500">Formulário:</span> <%= formulario.template.titulo %>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-gray-200 flex items-center justify-between">
              <span class="text-[10px] uppercase font-bold text-green-600 tracking-wider">Status: Respondido</span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

</div>
