<section class="main-area">
  <% if flash[:alert] %>
    <div class="error">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <div class="formulario-modal-container">
    <h2><%= @formulario.nome %></h2>

    <%= form_with url: enviar_respostas_user_avaliacao_path(@formulario), method: :post do |f| %>
      <% respostas_params = params[:respostas] || {} %>
      <% @perguntas.each do |pergunta| %>
        <div class="pergunta">
          <label><%= pergunta.pergunta %></label><br>

          <% resposta_valor = respostas_params[pergunta.id.to_s] %>

          <% if pergunta.tipo == 0 %> 
            <!-- Multiple choice with radio buttons -->
            <% pergunta.opcoes.order(:item).each do |opcao| %>
              <label class="radio-option">
                <input type="radio" 
                      name="respostas[<%= pergunta.id %>]" 
                      value="<%= opcao.opcao %>" 
                      <%= 'checked' if resposta_valor == opcao.opcao %> 
                      >
                <%= opcao.opcao %>
              </label><br>
            <% end %>

          <% elsif pergunta.tipo == 1 %> 
            <!-- Resposta de texto -->
            <textarea name="respostas[<%= pergunta.id %>]" ><%= resposta_valor %></textarea>

          <% else %>
            <!-- Resposta de múltipla escolha -->
            <input type="text" 
                  name="respostas[<%= pergunta.id %>]" 
                  value="<%= resposta_valor %>" 
                   />
          <% end %>
        </div>
      <% end %>

      <div style="margin-top: 1rem;">
        <%= f.submit "Enviar", class: "btn-submit" %>
        <%= link_to "Cancelar", user_avaliacoes_path, class: "btn-cancel" %>
      </div>
    <% end %>
  </div>
</section>


<script>
  document.addEventListener("DOMContentLoaded", () => {
    const alertBox = document.querySelector(".error");
    if (alertBox) {
      setTimeout(() => {
        alertBox.style.opacity = "0";
        setTimeout(() => alertBox.remove(), 500);
      }, 2000);
    }
  });
</script>