<% content_for :title, "Importação de Dados do SIGAA" %>

<h1>Importação de Dados do SIGAA</h1>

<%= form_with scope: :sigaa_sync, url: imports_sigaa_path, method: :post do |form| %>
  <div class="form-group">
    <%= form.label :semester, "Período letivo" %>
    <%= form.select :semester, options_for_select(@semesters, @semester) %>
  </div>

  <div class="form-group">
    <%= form.label :scope, "Dados para sincronizar" %>
    <p>Turmas, Matérias e Participantes</p>
  </div>

  <%= form.submit "Sincronizar turmas, matérias e participantes", class: "btn btn-primary" %>
<% end %>

<p><%= link_to "Voltar ao painel", root_path, class: "btn-link" %></p>
