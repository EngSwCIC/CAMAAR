<h1>Login</h1>

<%= form_with scope: :session, url: login_path do |form| %>
  <div class="form-group">
    <%= form.label :identifier, "Email ou matricula" %>
    <%= form.text_field :identifier %>
  </div>

  <div class="form-group">
    <%= form.label :password, "Senha" %>
    <%= form.password_field :password %>
  </div>

  <%= form.submit "Entrar", class: "btn btn-primary" %>
<% end %>

<p class="auth-panel__back"><%= link_to "Esqueci minha senha", new_password_reset_path, class: "btn-link" %></p>
