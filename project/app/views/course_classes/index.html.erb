<% content_for :title, "Gerenciamento de Turmas" %>

<h1>Gerenciamento de Turmas</h1>

<% if @course_classes.empty? %>
  <p>Nenhuma turma encontrada para o seu departamento no semestre atual.</p>
<% else %>
  <div id="turmas" class="card-grid">
    <% @course_classes.each do |course_class| %>
      <div class="card turma">
        <h3><%= course_class.name %></h3>
        <p class="card-subtitle">Departamento: <%= course_class.department.name %></p>
        <p class="card-subtitle">Semestre: <%= course_class.semester %></p>

        <%= link_to "Avaliar desempenho", course_class_path(course_class), class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
<% end %>

<%= link_to "Voltar ao painel", root_path, class: "btn-link" %>
