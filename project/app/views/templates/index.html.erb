<p style="color: green"><%= notice %></p>
<p style="color: red"><%= alert %></p>

<% content_for :title, "Meus Templates" %>

<h1>Meus Templates</h1>

<div id="templates">
  <% @templates.each do |template| %>
    <div class="template" style="margin: 10px 0; padding: 10px; border: 1px solid #ccc;">
      <h3><%= template.title %></h3>
      <p><strong>Público-alvo:</strong> <%= template.target_role %></p>
      <p><strong>Questões:</strong> <%= template.questaos.count %></p>

      <div>
        <%= link_to "Editar", edit_template_path(template) %>
        <%= link_to "Deletar", template_path(template) %>
      </div>
    </div>
  <% end %>
</div>

<%= link_to "Novo template", new_template_path %>
