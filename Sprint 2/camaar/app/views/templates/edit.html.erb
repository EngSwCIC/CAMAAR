<div style="margin-bottom:24px;">
  <h1 style="font-size:1.4rem; color:#333; margin-bottom:4px;">Editar Template</h1>
  <p style="color:#888; font-size:0.85rem;">Atualize as informações do template base</p>
</div>

<div style="background:#fff; border-radius:4px; padding:24px; box-shadow:0 1px 6px rgba(0,0,0,0.08);">
  <%= render 'form', template: @template %>
</div>

<br>

<div>
  <%= link_to "Ver Template", @template %> |
  <%= link_to "Voltar para Templates", templates_path %>
</div>